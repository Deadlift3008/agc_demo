# Скопируй этот файл в .env и подставь свой ключ OpenRouter
OPENROUTER_API_KEY=sk-or-your-key-here

# Модель по умолчанию (можно переопределить в UI через селектор)
DEFAULT_MODEL=deepseek/deepseek-v4-flash

# Бюджет токенов на один ход агента (prompt + completion). 0 = без лимита.
# Soft stop: при приближении к лимиту оставляем reserve на финальный ответ.
MAX_TOKENS_PER_TURN=8000
TOKEN_BUDGET_RESERVE=500
